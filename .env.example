# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://workshops:workshops@localhost:5432/workshops?schema=public"
DATABASE_URL_UNPOOLED="postgresql://workshops:workshops@localhost:5432/workshops?schema=public"

# Signs the session cookie. Must be at least 32 characters. Never commit the real one.
SESSION_SECRET="replace-me-with-a-long-random-string"

# All times are stored in UTC and shown in this one time zone (IANA name).
NEXT_PUBLIC_CENTRE_TIMEZONE="Europe/London"

# Dev-only password used by the seed script for the three sample accounts.
SEED_PASSWORD="Workshop123!"