generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  admin
  manager
  staff
}

enum WorkshopStatus {
  draft
  open
  cancelled
  completed
}

enum RegistrationStatus {
  active
  cancelled
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  workshopsCreated       Workshop[]     @relation("WorkshopCreatedBy")
  workshopsUpdated       Workshop[]     @relation("WorkshopUpdatedBy")
  registrationsMade      Registration[] @relation("RegisteredBy")
  registrationsCancelled Registration[] @relation("CancelledBy")
  auditLogs              AuditLog[]

  @@map("users")
}

model Workshop {
  id              String         @id @default(uuid())
  code            String         @unique
  title           String
  instructor      String
  startsAt        DateTime       @map("starts_at")
  durationMinutes Int            @default(60) @map("duration_minutes")
  location        String
  description     String         @default("")
  capacity        Int
  activeCount     Int            @default(0) @map("active_count")
  status          WorkshopStatus @default(draft)
  createdById     String         @map("created_by")
  updatedById     String         @map("updated_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  createdBy     User           @relation("WorkshopCreatedBy", fields: [createdById], references: [id])
  updatedBy     User           @relation("WorkshopUpdatedBy", fields: [updatedById], references: [id])
  registrations Registration[]

  @@index([startsAt])
  @@index([status])
  @@map("workshops")
}

model Registration {
  id            String             @id @default(uuid())
  workshopId    String             @map("workshop_id")
  attendeeName  String             @map("attendee_name")
  attendeeEmail String             @map("attendee_email")
  status        RegistrationStatus @default(active)
  registeredById String            @map("registered_by")
  registeredAt  DateTime           @default(now()) @map("registered_at")
  cancelledById String?            @map("cancelled_by")
  cancelledAt   DateTime?          @map("cancelled_at")
  cancelReason  String?            @map("cancel_reason")

  workshop     Workshop @relation(fields: [workshopId], references: [id])
  registeredBy User     @relation("RegisteredBy", fields: [registeredById], references: [id])
  cancelledBy  User?    @relation("CancelledBy", fields: [cancelledById], references: [id])

  @@index([workshopId, status])
  @@map("registrations")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  changes    Json
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}